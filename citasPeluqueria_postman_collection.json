{
    "info": {
        "_postman_id": "citas-peluqueria-jwt-collection",
        "name": "Citas Peluqueria API (con JWT)",
        "description": "Colección para probar los servicios REST de Citas Peluqueria con autenticación JWT.\n\n### Instrucciones:\n1. Ejecuta la petición **'1. Login (Admin)'** primero.\n2. El token JWT se guardará automáticamente en las variables de la colección.\n3. Ya puedes ejecutar el resto de peticiones protegidas.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Autenticación",
            "item": [
                {
                    "name": "1. Login (Admin)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.token) {",
                                    "    pm.collectionVariables.set(\"jwt_token\", jsonData.token);",
                                    "    console.log(\"Token JWT actualizado correctamente\");",
                                    "} else {",
                                    "    console.error(\"No se recibió token en la respuesta\");",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        },
                        "description": "Login para obtener el token. El script de 'Tests' guarda automáticamente el token en la variable {{jwt_token}}."
                    },
                    "response": []
                },
                {
                    "name": "2. Registrar Nuevo Usuario (Solo Admin)",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"username\": \"nuevoPeluquero\",\n    \"password\": \"password123\",\n    \"role\": \"USER\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/register",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "register"
                            ]
                        }
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Citas",
            "item": [
                {
                    "name": "Obtener Todas las Citas",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/citas",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "citas"
                            ]
                        }
                    },
                    "response": []
