                {
                    "name": "Crear Cita",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"fecha\": \"2024-12-25\",\n  \"hora\": \"10:30:00\",\n  \"precio\": 15.50,\n  \"observaciones\": \"Corte de pelo moderno\",\n  \"cliente\": {\n    \"nombre\": \"Juan Pérez\",\n    \"tfno\": \"600123456\",\n    \"email\": \"juan@example.com\"\n  }\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/citas",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "citas"
                            ]
                        }
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Peluqueros (Solo Admin)",
            "item": [
                {
                    "name": "Obtener Peluqueros",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/peluquero",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "peluquero"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Crear Peluquero",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"nombre\": \"Estilista Profesional\",\n  \"tfno\": \"666777888\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/peluquero",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "peluquero"
                            ]
                        }
                    },
                    "response": []
                }
            ]
        }
    ],
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{jwt_token}}",
                "type": "string"
            }
        ]
    },
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    ""
                ]
            }
        },
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    ""
                ]
            }
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8080/api",
            "type": "string"
        },
        {
            "key": "jwt_token",
            "value": "",
            "type": "string"
        }
    ]
}